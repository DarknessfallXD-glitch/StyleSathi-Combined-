# Copy to .env and fill in real values. Never commit .env.

# --- Supabase (main project: products, users, auth) ---
SUPABASE_PROJECT_URL=
SUPABASE_SERVICE_KEY=
# Backend auth uses SUPABASE_API_KEY (anon/service) to build per-user clients
SUPABASE_API_KEY=

# --- Cloudinary (free cloud image host for TEMP product images) ---
# Sign up free at https://cloudinary.com -> Dashboard shows these three.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=stylesathi

# --- Embeddings ---
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1024

# --- Try-On / AI ---
REPLICATE_API_TOKEN=
COLAB_FLUX_URL=

# --- Affiliates ---
DARAZ_API_KEY=
FLIPKART_AFFILIATE_ID=
FLIPKART_API_KEY=
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_ASSOCIATE_TAG=stylesathi-21

# --- Subscriptions ---
STRIPE_SECRET_KEY=
